---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  size?: "lg" | "sm";
}
const { eyebrow, title, subtitle, size = "lg" } = Astro.props;
const isLg = size === "lg";
---

<section
  class:list={[
    "relative isolate overflow-hidden bg-brand-dark text-cream",
    isLg ? "pt-24 pb-24 lg:pt-32 lg:pb-32" : "pt-16 pb-16 lg:pt-20 lg:pb-20",
  ]}
>
  <!-- Soft radial glow -->
  <div
    class="pointer-events-none absolute -top-1/3 left-1/2 -z-10 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-brand/25 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <!-- Tree motif -->
  <img
    src="/tree-white.png"
    alt=""
    aria-hidden="true"
    class:list={[
      "pointer-events-none absolute -z-10 select-none opacity-[0.06]",
      isLg
        ? "-right-16 bottom-[-6rem] w-[34rem] md:opacity-[0.08]"
        : "-right-12 bottom-[-4rem] w-72",
    ]}
  />
  <!-- Subtle top border highlight -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="container-x">
    <div class:list={[isLg ? "max-w-3xl" : "max-w-2xl"]}>
      {
        eyebrow && (
          <p class="eyebrow eyebrow--invert" data-reveal>
            {eyebrow}
          </p>
        )
      }
      <h1
        class:list={[
          "mt-5 font-serif text-white",
          isLg ? "display" : "heading-lg",
        ]}
        data-reveal
        style="--reveal-delay:80ms"
      >
        {title}
      </h1>
      {
        subtitle && (
          <p
            class:list={[
              "mt-6 text-cream/75",
              isLg ? "max-w-2xl text-lg lg:text-xl" : "max-w-xl text-base lg:text-lg",
            ]}
            data-reveal
            style="--reveal-delay:160ms"
          >
            {subtitle}
          </p>
        )
      }
      {
        Astro.slots.has("actions") && (
          <div
            class="mt-9 flex flex-wrap gap-3"
            data-reveal
            style="--reveal-delay:240ms"
          >
            <slot name="actions" />
          </div>
        )
      }
    </div>
  </div>
</section>
