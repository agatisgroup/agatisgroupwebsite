---
interface Result {
  label: string;
  value: number;
  highlight: boolean;
}
interface Props {
  year: number;
  results: Result[];
  note?: string;
}
const { year, results, note } = Astro.props;
const max = Math.max(...results.map((r) => r.value));
const lead = results.find((r) => r.highlight) ?? results[0];
---

<div
  class="overflow-hidden rounded-3xl border border-line bg-white shadow-[var(--shadow-card)]"
>
  <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
    <!-- Headline figure -->
    <div class="flex flex-col justify-center bg-brand-dark p-8 text-cream lg:p-12">
      <p class="eyebrow eyebrow--invert">{year} Performance</p>
      <p class="mt-5 font-serif text-6xl leading-none text-white lg:text-7xl">
        {lead.value}%
      </p>
      <p class="mt-3 text-sm text-cream/70">{lead.label} total return</p>
    </div>

    <!-- Comparison bars -->
    <div class="flex flex-col justify-center gap-6 p-8 lg:p-12">
      {
        results.map((r, i) => (
          <div data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <div class="flex items-baseline justify-between gap-4">
              <span
                class:list={[
                  "text-sm",
                  r.highlight ? "font-semibold text-ink" : "text-ink-soft",
                ]}
              >
                {r.label}
              </span>
              <span
                class:list={[
                  "font-serif text-lg tabular-nums",
                  r.highlight ? "text-brand" : "text-ink-soft",
                ]}
              >
                {r.value}%
              </span>
            </div>
            <div class="mt-2 h-2.5 w-full overflow-hidden rounded-full bg-brand-tint">
              <div
                class:list={[
                  "h-full rounded-full",
                  r.highlight ? "bg-brand" : "bg-ink/25",
                ]}
                style={`width:${(r.value / max) * 100}%`}
              />
            </div>
          </div>
        ))
      }
      {note && <p class="mt-2 text-xs leading-relaxed text-ink-soft">{note}</p>}
    </div>
  </div>
</div>
