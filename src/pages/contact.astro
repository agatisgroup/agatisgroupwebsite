---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import { contact, socials } from "../data/site";

const methods = [
  {
    label: "Email",
    value: contact.email,
    href: `mailto:${contact.email}`,
    icon: "M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z",
    external: false,
  },
  {
    label: "Phone / WhatsApp",
    value: contact.phone,
    href: contact.whatsapp,
    icon: "M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 0 1 6.9 12.6 8.2 8.2 0 0 1-10.9 2.6l-.35-.2-2.9.76.77-2.83-.22-.36A8.2 8.2 0 0 1 12 3.8Zm-3 3.7c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.55 2.02.8 2.43.64 2.87.6.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.92-1.18-.71-.63-1.19-1.42-1.33-1.66-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46Z",
    external: true,
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Agatis Group to discuss co-investment, collaboration, and partnership opportunities across our public and private portfolio."
>
  <Hero
    size="sm"
    eyebrow="Contact"
    title="Let's start a conversation."
    subtitle="We welcome inquiries around co-investment, collaboration, and founder partnerships. Reach out and we'll get back to you."
  />

  <Section bg="cream">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <!-- Contact methods -->
      <div data-reveal>
        <p class="eyebrow">Get in touch</p>
        <h2 class="mt-5 heading-lg">Direct lines.</h2>
        <div class="mt-8 space-y-4">
          {
            methods.map((m) => (
              <a
                href={m.href}
                target={m.external ? "_blank" : undefined}
                rel={m.external ? "noopener noreferrer" : undefined}
                class="group flex items-center gap-5 rounded-2xl border border-line bg-white p-5 shadow-[var(--shadow-card)] transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-0.5 hover:border-brand/30 hover:shadow-[var(--shadow-card-hover)]"
              >
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-tint text-brand transition-colors group-hover:bg-brand group-hover:text-white">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                    <path d={m.icon} />
                  </svg>
                </span>
                <span>
                  <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
                    {m.label}
                  </span>
                  <span class="mt-1 block font-serif text-xl text-ink">
                    {m.value}
                  </span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="mt-8">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">
            Follow us
          </p>
          <div class="mt-4 flex gap-3">
            {
              socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="flex h-11 w-11 items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:border-brand hover:bg-brand-tint hover:text-brand"
                >
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d={s.icon} />
                  </svg>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- What we discuss -->
      <div
        class="relative isolate overflow-hidden rounded-3xl bg-brand-dark p-8 text-cream lg:p-10"
        data-reveal
        style="--reveal-delay:120ms"
      >
        <img
          src="/tree-white.png"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute -bottom-16 -right-10 -z-10 w-64 select-none opacity-[0.07]"
        />
        <h2 class="font-serif text-2xl text-white">What we'd love to discuss</h2>
        <ul class="mt-6 space-y-4 text-cream/80">
          {
            [
              "Co-investment opportunities in Indonesian public and private companies",
              "Strategic minority partnerships with founder-led businesses",
              "Collaboration across our digital agency and media platforms",
            ].map((item) => (
              <li class="flex items-start gap-3">
                <svg
                  class="mt-1 h-5 w-5 shrink-0 text-gold"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                >
                  <path
                    d="m5 13 4 4L19 7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
        <div class="mt-8 border-t border-white/10 pt-6 text-sm text-cream/60">
          <p>PT Agatis Investama Abadi</p>
          <p class="mt-1">Based in Indonesia</p>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
